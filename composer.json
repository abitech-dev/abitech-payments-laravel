{
    "name": "abitech/payments-laravel",
    "description": "Motor de pasarelas de pago para aplicaciones Laravel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-bcmath": "*",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/collections": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/log": "^12.0|^13.0",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5.50|^12.5.8|^13.0",
        "orchestra/testbench": "^10.0|^11.0",
        "mockery/mockery": "^1.6",
        "mercadopago/dx-php": "^3.0",
        "stripe/stripe-php": "^15.0"
    },
    "suggest": {
        "mercadopago/dx-php": "Requerido para usar los drivers de Mercado Pago (^3.0)",
        "stripe/stripe-php": "Requerido para usar los drivers de Stripe (^15.0+)"
    },
    "autoload": {
        "psr-4": {
            "Abitech\\Payments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Abitech\\Payments\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Abitech\\Payments\\Providers\\PaymentsServiceProvider"
            ],
            "aliases": {
                "Payment": "Abitech\\Payments\\Facades\\Payment"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
